# Data source for the independent admin panel.
# demo: empty, memory-only local preview; every screen starts without records,
#       nothing is sent to a backend and entered records disappear on reload.
#       This is the default.
# api:  same-origin /api/admin/operations/* adapter using the browser session cookie.
# Any other value is a configuration error and the app will not start.
VITE_DATA_MODE=demo

# Neutral environment badge only: staging or production.
VITE_APP_ENV=staging
